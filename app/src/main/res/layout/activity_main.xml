<?xml version="1.0" encoding="utf-8"?>
<!-- 2차 시안: 메인 = 상태 문장 + 카메라(개발·시연용) + 큰 버튼 2개 + 더보기. 나머지 기능은 더보기 화면으로. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:keepScreenOn="true">
    <!-- keepScreenOn: 걷는 동안 화면이 꺼지면 카메라와 탐지가 멈추므로 메인 화면에서는 화면을 켜 둠 -->

    <!-- 메인 화면 -->
    <LinearLayout android:id="@+id/mainPanel"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="16dp">

        <LinearLayout android:id="@+id/statusBlock"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="4dp" android:paddingEnd="4dp"
            android:paddingTop="4dp" android:paddingBottom="12dp"
            android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <TextView android:id="@+id/tvStatus" style="@style/UiBody"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/ui_status_waiting" android:textSize="30sp"
                android:textStyle="bold" android:accessibilityLiveRegion="polite"/>
            <TextView android:id="@+id/tvStatusDetail" style="@style/UiSecondary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="@string/ui_status_detail"
                android:accessibilityLiveRegion="polite"/>
            <!-- 최근 경고 한 줄: 탐지 쪽에서 문장을 넘겨주기 전까지는 숨김.
                 상태 문장을 누르면 함께 읽으므로 여기서는 따로 읽지 않음 -->
            <TextView android:id="@+id/tvLastWarning" style="@style/UiSecondary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textColor="@color/ui_accent"
                android:visibility="gone"/>
        </LinearLayout>

        <View android:id="@+id/statusDivider"
            android:layout_width="match_parent" android:layout_height="2dp"
            android:layout_marginBottom="12dp" android:background="@color/ui_divider"
            android:importantForAccessibility="no"/>

        <!-- 개발·시연용 카메라 화면 (탐지 상자 표시). 톡백 초점에서 제외 -->
        <FrameLayout android:id="@+id/cameraFrame"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:background="@color/ui_surface"
            android:importantForAccessibility="noHideDescendants">
            <androidx.camera.view.PreviewView android:id="@+id/viewFinder"
                android:layout_width="match_parent" android:layout_height="match_parent"
                app:scaleType="fitCenter" app:implementationMode="compatible"/>
            <com.finalproject.navigation.OverlayView android:id="@+id/overlayView"
                android:layout_width="match_parent" android:layout_height="match_parent"/>

            <!-- 시연 화면 전용: 위쪽 안내 줄 (탐지 상태 · 감지 개수 · 가장 가까운 물체) -->
            <LinearLayout android:id="@+id/demoHeader"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_gravity="top" android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp" android:layout_marginTop="12dp"
                android:background="@drawable/demo_pill"
                android:orientation="vertical" android:paddingStart="14dp"
                android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp"
                android:visibility="gone">
                <!-- 첫째 줄: 탐지 상태 · 감지 개수 -->
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:gravity="center_vertical"
                    android:orientation="horizontal">
                <View android:id="@+id/demoDot" android:layout_width="10dp"
                    android:layout_height="10dp" android:background="@drawable/demo_dot"
                    android:backgroundTint="#7EE08A"/>
                <TextView android:id="@+id/demoState" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="8dp"
                    android:text="@string/demo_state_active" android:textColor="@color/ui_text"
                    android:textSize="16sp" android:textStyle="bold"/>
                <!-- 항목 사이 가운뎃점: "탐지 중 · 감지 객체 6개" 처럼 읽히게 함 -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:layout_marginEnd="8dp"
                    android:text="·" android:textColor="#99FFFFFF" android:textSize="13sp"
                    android:importantForAccessibility="no"/>
                <TextView android:id="@+id/demoCount" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:maxLines="1"
                    android:textColor="#DDDDDD" android:textSize="13sp"/>
                </LinearLayout>
                <!-- 둘째 줄: 가장 가까운 물체와 거리 (점 아래 글자 시작선에 맞춤, 길면 두 줄까지 줄바꿈) -->
                <TextView android:id="@+id/demoNearest" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginStart="18dp"
                    android:layout_marginTop="4dp" android:maxLines="2"
                    android:textColor="#DDDDDD" android:textSize="13sp"/>
            </LinearLayout>

            <!-- 시연 화면 전용: 아래쪽 진행 줄 + 안내 문구 -->
            <LinearLayout android:id="@+id/demoFooter"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_gravity="bottom" android:orientation="vertical"
                android:paddingStart="24dp" android:paddingEnd="24dp"
                android:paddingBottom="28dp" android:visibility="gone">
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:indeterminate="true" app:trackThickness="2dp"
                    app:indicatorColor="#CCFFFFFF" app:trackColor="#33FFFFFF"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:gravity="center"
                    android:text="@string/demo_caption" android:textColor="#CCFFFFFF"
                    android:textSize="17sp"/>
            </LinearLayout>
        </FrameLayout>

        <!-- 큰 버튼 2개: 높이를 고정하지 않고 최소 160dp로 둠 (폰 글자 크기를 키워도 글자가 잘리지 않게) -->
        <LinearLayout android:id="@+id/bigButtonRow"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:orientation="horizontal"
            android:baselineAligned="false">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnToggleDetection"
                style="@style/UiBigButton" android:layout_width="0dp"
                android:layout_height="match_parent" android:layout_weight="1"
                android:minHeight="160dp" android:textSize="24sp" app:iconSize="40dp"
                android:text="@string/ui_pause" app:icon="@drawable/ic_ui_pause"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnDestinationVoice"
                style="@style/UiBigButton.White" android:layout_width="0dp"
                android:layout_height="match_parent" android:layout_weight="1"
                android:minHeight="160dp"
                android:layout_marginStart="12dp" android:textSize="24sp" app:iconSize="40dp"
                android:text="@string/ui_destination_voice" app:icon="@drawable/ic_ui_mic"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton android:id="@+id/btnMore"
            style="@style/UiButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:gravity="center" android:minHeight="64dp"
            android:text="@string/ui_more"/>
    </LinearLayout>

    <!-- 더보기 화면 -->
    <androidx.core.widget.NestedScrollView android:id="@+id/morePanel"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@color/ui_background" android:fillViewport="true"
        android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <TextView android:id="@+id/tvMoreTitle" style="@style/UiBody"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:layout_marginBottom="8dp"
                android:text="@string/ui_more_title" android:textSize="28sp"
                android:textStyle="bold" android:focusable="true"/>

            <com.google.android.material.button.MaterialButton android:id="@+id/btnDestinationText"
                style="@style/UiButton" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="@string/ui_destination_text"/>

            <com.google.android.material.button.MaterialButton android:id="@+id/btnVoiceCommand"
                style="@style/UiButton" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:text="@string/ui_voice_command"/>
            <TextView style="@style/UiSecondary" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginStart="4dp"
                android:layout_marginTop="6dp" android:text="@string/ui_voice_help"/>

            <com.google.android.material.button.MaterialButton android:id="@+id/btnLastWarning"
                style="@style/UiButton" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:text="@string/ui_last_warning_replay"/>

            <com.google.android.material.button.MaterialButton android:id="@+id/btnSelectVideo"
                style="@style/UiButton" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:text="@string/ui_video"/>
            <TextView android:id="@+id/tvVideoResult" style="@style/UiSecondary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:layout_marginTop="6dp"
                android:visibility="gone" android:accessibilityLiveRegion="polite"/>

            <com.google.android.material.button.MaterialButton android:id="@+id/btnDemoMode"
                style="@style/UiButton" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:text="@string/ui_demo_mode"/>

            <com.google.android.material.button.MaterialButton android:id="@+id/btnSettings"
                style="@style/UiButton" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:text="@string/ui_settings"/>

            <TextView style="@style/UiSecondary" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginStart="4dp"
                android:layout_marginTop="20dp" android:text="@string/ui_safety"/>

            <Space android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:minHeight="16dp"/>

            <com.google.android.material.button.MaterialButton android:id="@+id/btnBack"
                style="@style/UiButton" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:gravity="center" android:text="@string/ui_back"
                app:backgroundTint="@color/ui_white_button"
                android:textColor="@color/ui_on_white_button"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
